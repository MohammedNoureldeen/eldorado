NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://eldorado:change-me@localhost:5432/eldorado?schema=public
SESSION_COOKIE_NAME=eldorado_session
SESSION_COOKIE_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=7
# JSON map of key versions to base64-encoded 32-byte AES keys.
CREDENTIAL_ENCRYPTION_KEYS={"v1":"replace-with-base64-32-byte-key"}
CREDENTIAL_ACTIVE_KEY_VERSION=v1
FUT_BASE_URL=https://futtransfer.top
FUT_API_USER=replace-me@example.com
# Store only the MD5 hash required by FUT Transfer; never store the plaintext API key.
FUT_API_KEY_MD5=00000000000000000000000000000000
# Internal economic cost for owned sender stock, in USD cents per 100K coins.
FUT_OWNED_COST_PER_100K_MINOR=0
FUT_TIMEOUT_MS=8000
FUT_MAX_RETRIES=3
FUT_PRICE_TOLERANCE_BPS=500
FUT_LOW_BALANCE_MINOR=100000
# Use fake only for local/manual workflow testing. Production validation requires http.
FUT_PROVIDER_MODE=fake
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me
TELEGRAM_ENABLED=false
S3_ENDPOINT=https://storage.example.invalid
S3_BUCKET=eldorado-proof
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_SIGNED_URL_TTL_SECONDS=300
MALWARE_SCANNER_URL=
MALWARE_SCAN_REQUIRED=false
MALWARE_SCANNER_TIMEOUT_MS=5000
# Use memory only for local fake-provider testing. Production validation requires s3.
PROOF_STORAGE_MODE=memory
SENTRY_DSN=
HEALTHCHECK_TOKEN=replace-me
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_WORKER_EMAIL=worker@example.invalid
SEED_WORKER_PASSWORD=replace-with-a-strong-password
